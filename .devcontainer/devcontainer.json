{
  "name": "Chegou a Conta, Diretora!",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "postCreateCommand": "sudo apt-get update -qq && sudo apt-get install -y -qq build-essential python3 && npm install && npm run db:push && node scripts/seed-demo.mjs",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "Aplicativo",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "alexcvzz.vscode-sqlite"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true,
        "typescript.preferences.importModuleSpecifier": "relative"
      }
    }
  },
  "remoteEnv": {
    "NODE_ENV": "development",
    "PORT": "5000",
    "SQLITE_DATABASE_URL": "file:dev.db",
    "ADMIN_PASSWORD": "admin2024"
  },
  "postStartCommand": "echo '\\n✅ Chegou a Conta, Diretora! pronto.\\n📌 Escolas demo: 35000001 · 31000002 · 43000003\\n🌐 Acesse: http://localhost:5000\\n'"
}
