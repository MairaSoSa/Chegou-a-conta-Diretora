{
  "name": "chegou-a-conta-diretora",
  "version": "1.0.0",
  "description": "Dashboard de gestão financeira para escolas públicas brasileiras",
  "license": "MIT",
  "scripts": {
    "dev": "node dist/bootstrap.cjs",
    "start": "bash start.sh",
