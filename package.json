{
  "name": "chegou-a-conta-diretora",
  "version": "1.0.0",
  "description": "Dashboard de gestão financeira para escolas públicas brasileiras",
  "license": "MIT",
  "scripts": {
    "dev": "set -a; [ -f .env ] && . ./.env; set +a; node dist/bootstrap.cjs",
    "sync:mec": "node scripts/sync-mec-contatos.mjs",
    "sync:saude:tipos": "node scripts/sync-saude-tipounidades.mjs",
    "sync:saude:contatos": "node scripts/sync-saude-contatos.mjs",
    "sync:pse:adesao": "node scripts/sync-pse-adesao.mjs",
    "prestart": "npm run sync:mec && npm run sync:pse:adesao && npm run prune:assets:apply",
    "start": "bash start.sh",
    "prune:assets": "bash scripts/prune-dist-assets.sh",
    "prune:assets:apply": "bash scripts/prune-dist-assets.sh --apply",
    "preflight": "npm run validate:config && npm run validate:structure",
    "validate:config": "set -a; [ -f .env ] && . ./.env; set +a; echo '✓ .env válido'",
    "validate:structure": "node scripts/validate-build.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^0.1.97"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.22.0"
  },
  "keywords": [
    "educação",
    "brasil",
    "financeiro",
    "escolas",
    "gestão"
  ],
  "dependencies": {
    "pg": "^8.20.0"
  }
}
