# ========================================
# ⚙️  CHEGOU A CONTA, DIRETORA - .env
# ========================================

# 🗄️ DATABASE CONFIGURATION
# ────────────────────────────────────────
# Use Railway PostgreSQL em produção
# NÃO use SQLite (file:./dev.db) em produção
# 
# Formato:  postgresql://user:password@host:port/database
# Exemplo: postgresql://postgres:PASSWORD@hopper.proxy.rlwy.net:24550/railway
#
DATABASE_URL=postgresql://postgres:PASSWORD@hopper.proxy.rlwy.net:24550/railway

# 🏥 API DADOS ABERTOS SAUDE (CNES)
# ────────────────────────────────────────
# Base de dados (CNES): https://apidadosabertos.saude.gov.br/
# Swagger/UI: https://apidadosabertos.saude.gov.br/v1/
# Endpoints usados:
# - /cnes/tipounidades (descobrir codigos de tipo: UBS, UPA, pronto socorro)
# - /cnes/estabelecimentos (listar unidades com filtros)
# - /cnes/estabelecimentos/{codigo_cnes} (detalhar contato de uma unidade)
#
# Exemplo de consulta:
# ${SAUDE_API_BASE_URL}${SAUDE_API_CNES_ESTABELECIMENTOS_PATH}?codigo_municipio=3550308&codigo_tipo_unidade=XX&status=1&limit=20&offset=0
#
SAUDE_API_BASE_URL=https://apidadosabertos.saude.gov.br
SAUDE_API_CNES_TIPOUNIDADES_PATH=/cnes/tipounidades
SAUDE_API_CNES_ESTABELECIMENTOS_PATH=/cnes/estabelecimentos
SAUDE_API_CNES_ESTABELECIMENTO_POR_CODIGO_PATH=/cnes/estabelecimentos/{codigo_cnes}

# Filtros padrao
SAUDE_API_STATUS=1
SAUDE_API_CODIGO_UF=
# Aceita codigo IBGE de 7 digitos (script converte para 6 no CNES)
SAUDE_API_CODIGO_MUNICIPIO=3550308
SAUDE_API_DATA_ATUALIZACAO_MIN=
SAUDE_API_ESTABELECIMENTO_POSSUI_CENTRO_CIRURGICO=
SAUDE_API_ESTABELECIMENTO_POSSUI_CENTRO_OBSTETRICO=

# Preencher com os codigos reais obtidos em /cnes/tipounidades
SAUDE_API_CODIGO_TIPO_UBS=2
SAUDE_API_CODIGO_TIPO_UPA=73
SAUDE_API_CODIGO_TIPO_PRONTO_SOCORRO=20
SAUDE_API_CODIGOS_TIPO_UBS=1,2
SAUDE_API_CODIGOS_TIPO_UPA=73
SAUDE_API_CODIGOS_TIPO_PRONTO_SOCORRO=20,21

# Campo para consulta detalhada por unidade (endpoint /cnes/estabelecimentos/{codigo_cnes})
SAUDE_API_CODIGO_CNES_DETALHE=

# Referencia da escola para priorizacao por proximidade
# Se vazio, o script usa o centroide do municipio (municipio-centroides.json)
SAUDE_ESCOLA_LATITUDE=
SAUDE_ESCOLA_LONGITUDE=

# Paginacao (limite maximo do endpoint: 20)
SAUDE_API_LIMIT=20
SAUDE_API_OFFSET=0

# Controle de sincronizacao de contatos de saude
SAUDE_API_MAX_PAGINAS=5
SAUDE_PRIORIZACAO_TOP_N=15
SAUDE_CONTATOS_OUTPUT_JSON=saude-contatos-priorizados.json

# 🏛️ CNEAS — ONGs E ENTIDADES DE ASSISTÊNCIA SOCIAL
# ────────────────────────────────────────
# Fonte: dados.gov.br — CNEAS e CEBAS
# Script de sincronização: node scripts/sync-ongs-contatos.mjs
#
# Código IBGE do município (6 ou 7 dígitos)
ONG_CODIGO_MUNICIPIO=3550308
# UF do município (sigla, ex: SP) — informativo, não filtrado via API
ONG_UF=SP
# Número máximo de entidades a priorizar no arquivo local
ONG_TOP_N=15
# Caminho do arquivo JSON gerado pelo script de sincronização
ONG_CONTATOS_OUTPUT_JSON=ongs-contatos.json

# 🔐 ADMIN CREDENTIALS
# ────────────────────────────────────────
# Senha para acesso ao painel administrativo
# Altere em produção! Use uma senha forte (20+ caracteres)
#
ADMIN_PASSWORD=admin2024

# 🔎 SIGPC / dados.gov.br (Opcional, recomendado)
# ────────────────────────────────────────
# Chave para consultas SIGPC via OLINDA (dados.gov.br / FNDE).
# O runtime aceita qualquer uma das variáveis abaixo (ordem de prioridade):
# DADOS_GOV_API_KEY > SIGPC_API_KEY > OLINDA_API_KEY > DADOSGOVBR_API_KEY
#
# Observacao: mesmo com chave correta, o servico pode ficar indisponivel
# temporariamente por falha externa do FNDE/OLINDA (ex.: ORA-00942).
#
DADOS_GOV_API_KEY=
SIGPC_API_KEY=
OLINDA_API_KEY=
DADOSGOVBR_API_KEY=

# 🤖 OpenAI API (Opcional)
# ────────────────────────────────────────
# Para funcionalidade de Caderno da Diretora com IA
# Obtenha em: https://platform.openai.com/api-keys
# Se vazio, IA desativada
#
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 🚀 APPLICATION SETTINGS
# ────────────────────────────────────────
# NODE_ENV: development | production
# PORT: Porta do servidor (padrão: 5000)
#
NODE_ENV=development
PORT=5000

# 💡 NOTES
# ────────────────────────────────────────
# • NUNCA commite .env com valores reais
# • Use este arquivo como template
# • Em Railway, configure via UI ou CLI
# • Valide após mudanças: npm run preflight
